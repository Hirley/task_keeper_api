# Copie para .env (`cp .env.example .env`) e preencha antes de rodar via
# Docker (docker-compose.yml) ou em produção. .env não é versionado (ver
# .gitignore) — nunca coloque valores reais neste arquivo .env.example.

# Obrigatória em produção: este projeto não tem config/master.key nem
# config/credentials.yml.enc, então o Rails usa esta variável como
# secret_key_base. Gere uma com `bin/rails secret` (ou `openssl rand -hex 64`).
SECRET_KEY_BASE=

# Opcional — ver README, seção "Notificação de atraso via Telegram".
# Sem isso, o envio de lembretes é simplesmente pulado (não é um erro).
TELEGRAM_BOT_TOKEN=

# Opcional — domínio(s) permitido(s) em produção (ver
# config/environments/production.rb, config.hosts).
APP_HOST=

# Opcional — tamanho do pool de conexões do banco (ver config/database.yml).
RAILS_MAX_THREADS=5
