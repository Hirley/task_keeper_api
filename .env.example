# Copie para .env (`cp .env.example .env`) só se quiser sobrescrever algum
# valor — não é obrigatório pra rodar via `docker compose up` (ver README,
# seção "Docker"), que já tem defaults pra uso local/demo. .env não é
# versionado (ver .gitignore) — nunca coloque valores reais neste arquivo
# .env.example.

# Obrigatória em produção. Este projeto não tem config/master.key nem
# config/credentials.yml.enc, então o Rails usa esta variável como
# secret_key_base — é ela que assina o cookie de sessão, e quem a conhece
# consegue forjar um cookie e autenticar como qualquer usuário. Nunca
# versione, nunca reaproveite entre ambientes. Gere uma com
# `bin/rails secret` (ou `openssl rand -hex 64`).
#
# Deixando vazia, bin/docker-entrypoint gera uma chave efêmera por
# execução, pra que `docker compose up` funcione sem passo manual — as
# sessões caem a cada restart do container.
SECRET_KEY_BASE=

# Redirect http->https, cookie de sessão marcado como Secure e HSTS.
# Ligado por padrão em produção; o docker-compose.yml define "false"
# porque a demo local é servida em http://localhost, sem TLS. Só desligue
# se souber por quê.
FORCE_SSL=

# Conexão com o PostgreSQL (ver config/database.yml). Em produção, se
# DATABASE_URL estiver definida (Railway e a maioria dos provedores
# injetam isso automaticamente ao anexar um serviço de Postgres), ela tem
# prioridade e as variáveis abaixo são ignoradas. Localmente/no
# docker-compose, as variáveis abaixo bastam — o docker-compose.yml já
# sobe um serviço "db" e aponta DB_HOST pra ele automaticamente.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=task_keeper_api_development

# Opcional — ver README, seção "Notificação de atraso via Telegram".
# Sem isso, o envio de lembretes é simplesmente pulado (não é um erro).
TELEGRAM_BOT_TOKEN=

# Opcional — domínio(s) permitido(s) em produção (ver
# config/environments/production.rb, config.hosts) e host usado nos links
# de redefinição de senha por e-mail/Telegram (config.action_mailer.default_url_options).
APP_HOST=

# Opcional — tamanho do pool de conexões do banco (ver config/database.yml).
RAILS_MAX_THREADS=5

# Opcional — número de processos do worker de jobs (Solid Queue; ver
# config/queue.yml e o serviço "worker" no docker-compose.yml). Um só
# basta para o volume atual; existe para escalar sem editar arquivo.
JOB_CONCURRENCY=1

# Opcional — nome/tag da imagem que os serviços web e worker usam no
# docker-compose.yml. O default (task-keeper-api:local) é o que o
# `docker compose up --build` monta. Existe para o smoke test do CI poder
# apontar o compose para uma imagem já buildada, em vez de buildar de novo
# (ver .github/workflows/ci.yml); também serve para rodar a stack contra
# uma imagem publicada, ex.: ghcr.io/hirley/task_keeper_api:2.0.1.
APP_IMAGE=
