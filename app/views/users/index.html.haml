- content_for :page_title, "Acessos"
%h1.visually-hidden Acessos

.d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-3
  %p.text-muted.mb-0 Apenas o líder cadastra novos usuários e altera permissões. Não há autocadastro.
  = link_to "Novo usuário", new_user_path, class: "btn btn-tk-primary text-nowrap"

.card.tk-card.mb-3
  .card-body
    = form_with url: users_path, method: :get, local: true, class: "row g-2 align-items-end" do |f|
      - if params[:sort].present?
        = f.hidden_field :sort, value: params[:sort]
      - if params[:direction].present?
        = f.hidden_field :direction, value: params[:direction]
      .col-md-6
        = f.label :q, "Buscar por nome ou e-mail", class: "tk-filter-label form-label mb-1"
        = f.text_field :q, value: @q, list: "user-name-suggestions", autocomplete: "off",
          class: "form-control", placeholder: "Digite um ou mais nomes/e-mails, separados por vírgula…"
        %datalist#user-name-suggestions
          - @name_suggestions.each do |name|
            %option{ value: name }
        %div.form-text Separe vários termos com vírgula pra buscar qualquer um deles.
      .col-md-3
        %span.tk-filter-label.form-label.mb-1.d-block Permissão
        .d-flex.flex-wrap.gap-2
          - User.roles.each_key do |role|
            = check_box_tag "role[]", role, @role_filter_keys.include?(role),
              id: "role_#{role}", class: "btn-check", autocomplete: "off"
            = label_tag "role_#{role}", role.humanize, class: "btn btn-sm btn-outline-secondary"
        %div.form-text Nenhum selecionado = todos.
      .col-md-3.d-flex.gap-2
        = f.submit "Filtrar", class: "btn btn-outline-secondary w-50"
        = link_to "Limpar", users_path, class: "btn btn-link text-secondary text-decoration-none w-50"

.table-responsive.tk-card
  %table.table.table-hover.align-middle
    %thead
      %tr
        %th= user_sort_header("name", "Nome")
        %th= user_sort_header("email", "E-mail")
        %th= user_sort_header("role", "Permissão")
        %th.text-end Ações
    %tbody
      - @users.each do |user|
        %tr
          %td= user.name
          %td= user.email
          %td
            %span{ class: "badge #{user.lider? ? 'tk-badge-lider' : 'tk-badge-executor'}" }
              = user.lider? ? "Líder" : "Executor"
          %td.text-end
            .d-flex.gap-2.justify-content-end
              = link_to "Editar permissões", edit_user_path(user), class: "btn btn-sm btn-outline-secondary"
              - if user == current_user
                %button.btn.btn-sm.btn-outline-danger{ disabled: true, title: "Você não pode excluir o seu próprio usuário" } Excluir
              - else
                = button_to "Excluir", user_path(user), method: :delete,
                  class: "btn btn-sm btn-outline-danger",
                  form: { data: { turbo_confirm: "Tem certeza que deseja excluir #{user.name}? Essa ação não pode ser desfeita." } }

    - if @users.empty?
      %tbody
        %tr
          %td.text-muted{ colspan: 4 }
            - if @q.present? || @role_filter.present?
              Nenhum usuário encontrado com os filtros aplicados.
            - else
              Nenhum usuário cadastrado ainda.

= render "shared/pagination", pagination: @pagination
