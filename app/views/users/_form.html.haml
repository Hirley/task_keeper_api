= form_with model: user, local: true do |f|
  - if user.errors.any?
    .alert.alert-danger
      %ul.mb-0
        - user.errors.full_messages.each do |message|
          %li= message

  .mb-3
    = f.label :name, "Nome", class: "form-label"
    = f.text_field :name, class: "form-control", required: true, autocomplete: "name"

  .mb-3
    = f.label :email, "E-mail", class: "form-label"
    = f.email_field :email, class: "form-control", required: true, autocomplete: "email"

  - if user.new_record?
    .mb-3
      = f.label :password, "Senha", class: "form-label"
      = f.password_field :password, class: "form-control", required: true, autocomplete: "new-password"

    .mb-3
      = f.label :password_confirmation, "Confirmação da senha", class: "form-label"
      = f.password_field :password_confirmation, class: "form-control", required: true, autocomplete: "new-password"

  .mb-3
    .d-flex.align-items-center.gap-1.mb-1
      = f.label :telegram_chat_id, "Chat ID do Telegram (opcional)", class: "form-label mb-0"
      - telegram_chat_id_help = "Pegar o Chat ID da sua própria conta (ID de Usuário):<br>• Abra o Telegram e pesquise pelo bot <strong>@WhatChatIDBot</strong> ou <strong>@ShowJsonBot</strong>.<br>• Inicie uma conversa com o bot e clique em Iniciar (/start).<br>• O bot responderá imediatamente mostrando o seu ID numérico."
      %button.tk-info-icon{ type: "button", tabindex: "0", "data-bs-toggle" => "tooltip", "data-bs-html" => "true", "data-bs-placement" => "right", title: telegram_chat_id_help, "aria-label" => "Como pegar o Chat ID do Telegram" }
        ⓘ
    = f.text_field :telegram_chat_id, class: "form-control", autocomplete: "off", inputmode: "numeric", placeholder: "Ex.: 123456789"
    %div.form-text Para receber lembretes de demandas atrasadas pelo Telegram (veja o ⓘ acima como descobrir o número).

  .mb-3
    = f.label :role, "Permissão", class: "form-label"
    = f.select :role, User.roles.keys.map { |role| [role.humanize, role] }, {}, class: "form-select"
    %div.form-text
      Líder pode gerenciar demandas de qualquer usuário e cadastrar/alterar acessos.
      Executor só cadastra e visualiza demandas.

  .d-flex.gap-2
    = f.submit(user.new_record? ? "Cadastrar" : "Salvar permissões", class: "btn btn-tk-primary")
    = link_to "Cancelar", users_path, class: "btn btn-outline-secondary"
