- content_for :page_title, "Início"
%h1.visually-hidden Início

/ Dispara o guia interativo sozinho (ver app/javascript/application.js
/ TkGuideTour): na primeira vez que o usuário chega aqui depois do
/ primeiro acesso (tour_completed_at ainda nil) ou quando vem do botão 🧭
/ da navbar (?tour=1 — ver app/views/layouts/application.html.haml).
#tk-tour-autostart{ hidden: true, data: { autostart: (params[:tour] == "1" || current_user.tour_completed_at.nil?).to_s } }

.mb-4
  %h2.h4.mb-1.tk-dashboard-greeting= "Olá, #{current_user.name}"
  %p.text-muted.mb-0
    - if current_user.lider_ou_admin?
      Aqui está o panorama da equipe hoje, #{Date.current.strftime('%d/%m/%Y')}.
    - else
      Aqui está o que precisa da sua atenção hoje, #{Date.current.strftime('%d/%m/%Y')}.

.row.g-3.mb-4{ data: { tour: "stats" } }
  .col-6.col-lg-3
    = link_to demandas_path, class: "stat-tile-link" do
      .stat-tile
        .stat-label Total de demandas
        .stat-value= @total
        .stat-sub de toda a equipe
  .col-6.col-lg-3
    = link_to demandas_path(status: ["pendente"]), class: "stat-tile-link" do
      .stat-tile.stat-tile-pendente
        .stat-label Pendentes
        .stat-value= @status_counts["pendente"]
        .stat-sub
          - if @total.positive?
            = "#{((@status_counts['pendente'].to_f / @total) * 100).round}% do total"
  .col-6.col-lg-3
    = link_to demandas_path(status: ["em_andamento"]), class: "stat-tile-link" do
      .stat-tile.stat-tile-andamento
        .stat-label Em andamento
        .stat-value= @status_counts["em_andamento"]
        .stat-sub
          - if @total.positive?
            = "#{((@status_counts['em_andamento'].to_f / @total) * 100).round}% do total"
  .col-6.col-lg-3
    = link_to demandas_path(status: ["concluida"]), class: "stat-tile-link" do
      .stat-tile.stat-tile-concluida
        .stat-label Concluídas
        .stat-value= @status_counts["concluida"]
        .stat-sub
          - if @total.positive?
            = "#{((@status_counts['concluida'].to_f / @total) * 100).round}% do total"

.row.g-3
  .col-lg-8
    .card.tk-card.mb-3{ data: { tour: "minhas-demandas" } }
      = link_to demandas_path(responsavel_id: current_user.id), class: "card-drilldown" do
        .card-header.d-flex.align-items-center.justify-content-between
          %span Minhas demandas
          %span.card-drilldown-chevron{ "aria-hidden" => "true" } ›
      .card-body.pt-2
        - if @minhas_demandas.any?
          %table.table.tk-table.mb-0
            %thead
              %tr
                %th Título
                %th Data
                %th Status
                %th
            %tbody
              - @minhas_demandas.each do |demanda|
                %tr{ class: ("text-muted" if demanda.concluida?) }
                  %td= demanda.title
                  %td= demanda.data.strftime("%d/%m")
                  %td
                    %span{ class: "badge tk-badge-status-#{demanda.status}" }= demanda.status.humanize
                  %td= prazo_badge(demanda)
        - else
          %p.text-muted.mb-0
            Você ainda não tem nenhuma demanda atribuída.
            = link_to "Criar demanda", new_demanda_path, style: "color: var(--tk-teal);"

    .card.tk-card
      = link_to demandas_path, class: "card-drilldown" do
        .card-header.d-flex.align-items-center.justify-content-between
          %span Atividade recente
          .d-flex.align-items-center.gap-2
            %small.text-muted últimas demandas criadas pela equipe
            %span.card-drilldown-chevron{ "aria-hidden" => "true" } ›
      .card-body.pt-2
        - if @atividade_recente.any?
          - @atividade_recente.each do |demanda|
            - destino = can?(:update, demanda) ? edit_demanda_path(demanda) : demandas_path(q: demanda.title)
            = link_to destino, class: "activity-item-link" do
              .activity-item
                %span.activity-dot
                %div
                  %div
                    %strong= demanda.title
                    = " — criada por #{demanda.user.name}"
                    - if demanda.concluida?
                      = ", concluída"
                  %div.activity-time= time_ago_in_words(demanda.created_at) + " atrás"
        - else
          %p.text-muted.mb-0 Nenhuma atividade ainda.

  .col-lg-4
    / O card com a barra empilhada + legenda por status foi removido:
    / os mesmos 3 valores já aparecem nos KPIs do topo (ver .row#stats
    / acima), com valor absoluto e percentual — era 100% redundante,
    / não só em telas pequenas (ver ROADMAP.md).
    .card.tk-card.mb-3
      .card-header Prazos
      .card-body.pt-2
        = link_to demandas_path(prazo: "atrasada"), class: "prazo-row-link" do
          .prazo-row
            %span Atrasadas
            %span.prazo-count.prazo-count-critical= @atrasadas
        = link_to demandas_path(prazo: "hoje"), class: "prazo-row-link" do
          .prazo-row
            %span Vencem hoje
            %span.prazo-count.prazo-count-warning= @vencem_hoje
        = link_to demandas_path(prazo: "breve"), class: "prazo-row-link" do
          .prazo-row
            %span= "Vencem em até #{DashboardController::PRAZO_PROXIMO_DIAS} dias"
            %span.prazo-count.prazo-count-neutral= @vencem_em_breve

    .card.tk-card.mb-3#carga-por-responsavel
      .card-header
        %span Carga por responsável
        %small.text-muted demandas abertas
      .card-body.pt-2
        - if @carga_por_responsavel.any?
          - max_carga = @carga_por_responsavel.map(&:last).max
          - @carga_por_responsavel.each do |id, nome, quantidade|
            = link_to demandas_path(responsavel_id: id), class: "load-row-link" do
              .load-row
                %span.load-name= nome
                .load-track
                  .load-fill{ style: "width: #{(quantidade.to_f / max_carga * 100).round}%" }
                %span.load-count= quantidade
        - else
          %p.text-muted.mb-0 Nenhuma demanda em aberto no momento.
