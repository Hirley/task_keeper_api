- content_for :page_title, "Definir senha"
.row.justify-content-center.mt-4
  .col-md-5
    .card.tk-login-card
      .tk-login-header
        %h1 Defina sua senha
        %p.mb-0.opacity-75 Por segurança, cadastre uma senha só sua antes de continuar.

      .card-body.p-4
        = form_with model: @user, url: definir_senha_path, method: :patch, local: true do |f|
          - if @user.errors.any?
            .alert.alert-danger
              %ul.mb-0
                - @user.errors.full_messages.each do |message|
                  %li= message

          .mb-3
            = f.label :password, "Nova senha", class: "form-label"
            = f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control", required: true

          .mb-3
            = f.label :password_confirmation, "Confirmação da nova senha", class: "form-label"
            = f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", required: true

          .d-grid
            = f.submit "Salvar senha", class: "btn btn-tk-primary"
