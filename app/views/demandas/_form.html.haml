= form_with model: demanda, local: true do |f|
  - if demanda.errors.any?
    .alert.alert-danger
      %ul.mb-0
        - demanda.errors.full_messages.each do |message|
          %li= message

  .mb-3
    = f.label :title, "Título", class: "form-label"
    = f.text_field :title, class: "form-control", required: true, autocomplete: "off", list: "demanda-title-suggestions"
    %datalist#demanda-title-suggestions
      - demanda_title_suggestions.each do |title|
        %option{ value: title }
    %div.form-text Comece a digitar para ver sugestões de títulos já usados antes.

  .mb-3
    = f.label :description, "Descrição", class: "form-label"
    = f.text_area :description, class: "form-control", rows: 4

  .mb-3
    = f.label :data, "Data", class: "form-label"
    - if demanda.new_record? || current_user.lider?
      = f.date_field :data, class: "form-control"
      %div.form-text Vem preenchida com a data de hoje, mas pode ser alterada.
    - else
      = f.date_field :data, class: "form-control", disabled: true
      = f.hidden_field :data
      %div.form-text Só o líder pode alterar a data de uma demanda já cadastrada.

  .mb-3
    = f.label :status, "Status", class: "form-label"
    = f.select :status, Demanda.statuses.keys.map { |status| [status.humanize, status] }, {}, class: "form-select"

  .d-flex.gap-2
    = f.submit "Salvar", class: "btn btn-tk-primary"
    = link_to "Cancelar", demandas_path, class: "btn btn-outline-secondary"
