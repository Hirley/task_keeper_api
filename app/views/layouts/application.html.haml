!!!
%html{ lang: "pt-BR" }
  %head
    %meta{ charset: "utf-8" }
    %meta{ name: "viewport", content: "width=device-width, initial-scale=1" }
    %title= content_for?(:page_title) ? "#{yield(:page_title)} · Task Keeper API" : "Task Keeper API"
    %link{ rel: "preconnect", href: "https://fonts.googleapis.com" }
    %link{ rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: "anonymous" }
    %link{ rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=Open+Sans:wght@300;400;600&display=swap" }
    %link{ rel: "stylesheet", href: "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", integrity: "sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH", crossorigin: "anonymous" }
    = stylesheet_link_tag "application"
    = csrf_meta_tags
    = csp_meta_tag
    = javascript_importmap_tags
  %body
    .tk-a11y-bar
      .container.d-flex.align-items-center.justify-content-end.gap-1
        %button.tk-a11y-btn{ type: "button", "aria-label" => "Diminuir tamanho da fonte", data: { tk_action: "font-decrease" } }
          A−
        %button.tk-a11y-btn{ type: "button", "aria-label" => "Aumentar tamanho da fonte", data: { tk_action: "font-increase" } }
          A+
        %button.tk-a11y-btn{ type: "button", "aria-label" => "Restaurar tamanho de fonte padrão", data: { tk_action: "font-reset" } }
          ↺A
        %button.tk-a11y-btn#tk-contrast-toggle{ type: "button", "aria-label" => "Ativar alto contraste", "aria-pressed" => "false", data: { tk_action: "contrast-toggle" } }
          ◐
        = link_to acessibilidade_path, class: "tk-a11y-btn", "aria-label" => "Acessibilidade — recursos e atalhos" do
          ♿

    %nav.navbar.navbar-expand-lg.navbar-dark.tk-navbar
      .container
        = link_to root_path, class: "navbar-brand tk-brand" do
          %span.tk-brand-badge TK
          Task Keeper API

        - if user_signed_in?
          %button.navbar-toggler{ type: "button", data: { bs_toggle: "collapse", bs_target: "#tkNavbar" }, "aria-controls" => "tkNavbar", "aria-expanded" => "false", "aria-label" => "Alternar navegação" }
            %span.navbar-toggler-icon

          #tkNavbar.collapse.navbar-collapse
            %ul.navbar-nav.me-auto
              %li.nav-item{ data: { tour: "nav-demandas" } }
                = link_to "Demandas", demandas_path, class: "nav-link#{' active' if current_page?(demandas_path)}"
              - if can? :manage, User
                %li.nav-item{ data: { tour: "nav-acessos" } }
                  = link_to "Acessos", users_path, class: "nav-link#{' active' if current_page?(users_path)}"
              - if can? :manage, WebhookSubscription
                %li.nav-item
                  = link_to "Webhooks", webhook_subscriptions_path, class: "nav-link#{' active' if current_page?(webhook_subscriptions_path)}"
              - if can? :read, :relatorio
                %li.nav-item
                  = link_to "Relatórios", relatorios_path, class: "nav-link#{' active' if current_page?(relatorios_path)}"

            = form_tag busca_path, method: :get, role: "search", class: "tk-search-form mt-3 mt-lg-0", data: { tour: "nav-busca" } do
              .tk-search-input-wrap
                = text_field_tag :q, params[:q], id: "tk-search-input", class: "form-control form-control-sm",
                  placeholder: "O que você precisa?", autocomplete: "off", role: "combobox",
                  "aria-label" => "Buscar demandas ou acessos", "aria-expanded" => "false",
                  "aria-controls" => "tk-search-results", "aria-autocomplete" => "list"
                %button#tk-search-mic.tk-search-mic-btn{ type: "button", "aria-label" => "Buscar por voz", title: "Buscar por voz", hidden: true }
                  🎤
                #tk-search-results.tk-search-dropdown{ role: "listbox", hidden: true }

            .d-flex.align-items-center.gap-2.mt-3.mt-lg-0.flex-shrink-0
              = link_to root_path(tour: 1), class: "btn btn-outline-light btn-sm tk-tour-trigger-btn", data: { tour: "tour-trigger" }, "aria-label" => "Rever o tour guiado", title: "Rever o tour guiado" do
                🧭
              %span.text-light.tk-user-chip.text-nowrap
                = current_user.name
                = " (#{current_user.role_label})"
              = button_to "Sair", destroy_user_session_path, method: :delete, class: "btn btn-outline-light btn-sm text-nowrap"

    .container.mt-4.mb-5
      - flash.each do |type, message|
        - next if type.to_s == "tour_pronto"
        .alert.tk-alert.alert-dismissible.fade.show{ class: "alert-#{type == 'alert' ? 'danger' : 'success'}", role: "alert" }
          = message
          - if type == "notice" && flash[:tour_pronto]
            %button.alert-link{ type: "button", data: { tk_action: "tour-start" }, style: "background: none; border: none; padding: 0; margin-left: 0.4rem; text-decoration: underline; cursor: pointer;" }
              Fazer o tour guiado agora
          %button.btn-close{ type: "button", data: { bs_dismiss: "alert" }, "aria-label" => "Fechar" }

      = yield

    %footer.tk-footer
      .container.d-flex.flex-wrap.justify-content-between.align-items-center.py-3
        %span Task Keeper API — organização de demandas diárias
        %span.text-white-50.small= "© #{Time.current.year}"

    %script{ src: "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js", integrity: "sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz", crossorigin: "anonymous" }

    / Widget oficial do governo federal para tradução em Libras (Língua
    / Brasileira de Sinais) — mesmo padrão usado em sites gov.br, incluindo
    / o da CGE-CE que inspirou a identidade visual deste app.
    .enabled{ vw: true }
      .active{ "vw-access-button" => true }
      %div{ "vw-plugin-wrapper" => true }
        .vw-plugin-top-wrapper
    %script{ src: "https://vlibras.gov.br/app/vlibras-plugin.js" }
    = javascript_tag "new window.VLibras.Widget('https://vlibras.gov.br/app');", nonce: true
