!!!
%html{ lang: "pt-BR" }
  %head
    %meta{ charset: "utf-8" }
    %meta{ name: "viewport", content: "width=device-width, initial-scale=1" }
    %title Task Keeper API
    %link{ rel: "stylesheet", href: "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" }
    = csrf_meta_tags
    = csp_meta_tag
  %body
    %nav.navbar.navbar-expand-lg.navbar-dark.bg-dark
      .container
        = link_to "Task Keeper API", root_path, class: "navbar-brand"
        - if user_signed_in?
          .d-flex.align-items-center
            %span.text-light.me-3
              = current_user.name
              = " (#{current_user.lider? ? 'líder' : 'executor'})"
            = button_to "Sair", destroy_user_session_path, method: :delete, class: "btn btn-outline-light btn-sm"

    .container.mt-4
      - flash.each do |type, message|
        .alert{ class: "alert-#{type == 'alert' ? 'danger' : 'success'}" }= message

      = yield
