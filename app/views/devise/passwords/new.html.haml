- content_for :page_title, "Esqueci minha senha"
.row.justify-content-center.mt-4
  .col-md-5
    .card.tk-login-card
      .tk-login-header
        %h1 Esqueci minha senha
        %p.mb-0.opacity-75 Informe seu e-mail para receber um link de redefinição.

      .card-body.p-4
        = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f|
          .mb-3
            = f.label :email, class: "form-label"
            = f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control"

          .d-grid
            = f.submit "Enviar instruções por e-mail", class: "btn btn-tk-primary"

        %p.text-muted.mt-3.mb-2
          Prefere pelo Telegram?
          = link_to "Redefinir por Telegram", new_telegram_password_reset_path

        %p.text-muted.mb-0
          = link_to "Voltar para o login", new_user_session_path
